# Copy to be/.env on each developer machine. Never commit real credentials.
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Use fresh random, different values for each secret.
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Optional: real password reset / onboarding email delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
