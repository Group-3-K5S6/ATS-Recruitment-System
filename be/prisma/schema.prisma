datasource db {
  provider = "sqlite"
  url      = "file:./ats.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  fullName     String
  phone        String?
  jobTitle     String?
  departmentId String?
  isActive     Boolean @default(true)

  // S1-01 - khóa tạm sau 5 lần đăng nhập sai liên tiếp
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // S1-04 - dùng để vô hiệu hóa các phiên đăng nhập cũ
  tokenVersion Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department         Department?  @relation(fields: [departmentId], references: [id])
  managedDepartments Department[] @relation("DepartmentManager")
  roles              UserRole[]
  auditLogs          AuditLog[]

  candidateProfile     Candidate?
  managedRequisitions  Requisition[] @relation("HiringManagerRequisitions")
  approvedRequisitions Requisition[] @relation("ApproverRequisitions")
  managedJobs          Job[]         @relation("HiringManagerJobs")
  assignedJobs         Job[]         @relation("RecruiterJobs")
  assignedApplications Application[] @relation("RecruiterApplications")
  interviews           Interview[]   @relation("InterviewerInterviews")
  evaluations          Evaluation[]  @relation("InterviewerEvaluations")
  createdOffers        Offer[]       @relation("RecruiterOffers")
  approvedOffers       Offer[]       @relation("ApproverOffers")

  // S1-03 / S1-04
  passwordHistories PasswordHistory[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  module      String
  description String
  roles       RolePermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id   String @id @default(uuid())
  name String
  code String @unique

  parentId String?
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Department[] @relation("DepartmentHierarchy")

  managerId String?
  manager   User?   @relation("DepartmentManager", fields: [managerId], references: [id], onDelete: Restrict)

  isActive Boolean @default(true)

  users        User[]
  requisitions Requisition[]
  jobs         Job[]
}

model JobTitle {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  level     String
  minSalary Float
  maxSalary Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]
}

model Requisition {
  id              String   @id @default(uuid())
  title           String
  departmentId    String
  hiringManagerId String
  approverId      String?
  status          String   @default("DRAFT")
  headcount       Int      @default(1)
  budget          Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  department    Department @relation(fields: [departmentId], references: [id])
  hiringManager User       @relation("HiringManagerRequisitions", fields: [hiringManagerId], references: [id])
  approver      User?      @relation("ApproverRequisitions", fields: [approverId], references: [id])
  jobs          Job[]
}

model Job {
  id              String   @id @default(uuid())
  title           String
  requisitionId   String?
  departmentId    String
  hiringManagerId String
  recruiterId     String?
  jobTitleId      String?
  status          String   @default("DRAFT")
  description     String
  location        String   @default("Hanoi")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  requisition          Requisition?             @relation(fields: [requisitionId], references: [id])
  department           Department               @relation(fields: [departmentId], references: [id])
  hiringManager        User                     @relation("HiringManagerJobs", fields: [hiringManagerId], references: [id])
  recruiter            User?                    @relation("RecruiterJobs", fields: [recruiterId], references: [id])
  jobTitle             JobTitle?                 @relation(fields: [jobTitleId], references: [id], onDelete: Restrict)
  applications         Application[]
  competencyFrameworks JobCompetencyFramework[]
  interviewQuestions   InterviewQuestion[]
}

model Candidate {
  id             String   @id @default(uuid())
  userId         String?  @unique
  fullName       String
  email          String
  phone          String?
  cvUrl          String?
  address        String?
  expectedSalary Float?
  currentCompany String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  applications Application[]
}

model Application {
  id                  String   @id @default(uuid())
  candidateId         String
  jobId               String
  stage               String   @default("APPLIED")
  status              String   @default("ACTIVE")
  assignedRecruiterId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  candidate         Candidate   @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job               Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  assignedRecruiter User?       @relation("RecruiterApplications", fields: [assignedRecruiterId], references: [id])
  interviews        Interview[]
  offers            Offer[]
}

model Interview {
  id              String   @id @default(uuid())
  applicationId   String
  interviewerId   String
  scheduledAt     DateTime
  durationMinutes Int      @default(60)
  status          String   @default("SCHEDULED")
  meetingLink     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  application Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer User         @relation("InterviewerInterviews", fields: [interviewerId], references: [id])
  evaluations Evaluation[]
}

model Evaluation {
  id             String   @id @default(uuid())
  interviewId    String   @unique
  interviewerId  String
  score          Int
  technicalNotes String
  culturalNotes  String?
  recommendation String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  interview   Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  interviewer User      @relation("InterviewerEvaluations", fields: [interviewerId], references: [id])
}

model Offer {
  id            String   @id @default(uuid())
  applicationId String
  recruiterId   String
  approverId    String?
  baseSalary    Float
  status        String   @default("DRAFT")
  internalNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  recruiter   User        @relation("RecruiterOffers", fields: [recruiterId], references: [id])
  approver    User?       @relation("ApproverOffers", fields: [approverId], references: [id])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  ipAddress    String?
  userAgent    String?
  metadata     String?
  createdAt    DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])
}

// S1-02
model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// S1-03 / S1-04
model PasswordHistory {
  id           String   @id @default(uuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// S1-03
model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model LoginAttempt {
  id             String    @id @default(uuid())
  email          String
  deviceId       String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([email, deviceId])
  @@index([email])
}

// S2-06 - Khung năng lực
model CompetencyFramework {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  criteria    CompetencyCriterion[]
  jobMappings JobCompetencyFramework[]
}

// S2-06 - Tiêu chí trong khung năng lực
model CompetencyCriterion {
  id          String   @id @default(uuid())
  frameworkId String
  name        String
  description String?
  weight      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  framework          CompetencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  interviewQuestions InterviewQuestion[]

  @@index([frameworkId])
}

// Liên kết chức danh với khung năng lực
model JobCompetencyFramework {
  jobId       String
  frameworkId String
  createdAt   DateTime @default(now())

  job       Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  framework CompetencyFramework @relation(fields: [frameworkId], references: [id], onDelete: Cascade)

  @@id([jobId, frameworkId])
  @@index([frameworkId])
}

// S2-07 - Ngân hàng câu hỏi phỏng vấn
model InterviewQuestion {
  id                    String   @id @default(uuid())
  question              String
  difficulty            String
  suggestedAnswer       String
  competencyCriterionId String
  jobId                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  criterion CompetencyCriterion @relation(fields: [competencyCriterionId], references: [id], onDelete: Restrict)
  job       Job?                @relation(fields: [jobId], references: [id], onDelete: Restrict)

  @@index([competencyCriterionId])
  @@index([jobId])
}
